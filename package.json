    "@nestjs/core": "^12.1.3",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/swagger": "^12.0.2",
    "@prisma/client": "^6.19.3",
    "@tanstack/react-query": "^5.104.2",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "html2canvas": "^1.4.1",
    "next": "^16.4.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reflect-metadata": "^0.2.2",
