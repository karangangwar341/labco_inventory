generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  STORE_ADMIN
  CLIENT_ADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
  LOCKED
}

enum OrganizationStatus {
  ACTIVE
  INACTIVE
}

enum LoginOutcome {
  SUCCESS
  INVALID_CREDENTIALS
  LOCKED_OUT
  ACCOUNT_DISABLED
}

enum CatalogScope {
  COMPANY
  CLIENT
}

enum ProductStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum TrackingMode {
  NONE
  BATCH_ONLY
  EXPIRY_ONLY
  BOTH
}

enum UnitStatus {
  ACTIVE
  SUPERSEDED
}

enum LocationType {
  WAREHOUSE
  CLIENT
}

enum StockCondition {
  USABLE
  DAMAGED
  EXPIRED
}

enum BatchStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

enum TransactionType {
  STOCK_IN
  STOCK_OUT
  TRANSFER_DISPATCH
  TRANSFER_RECEIPT
  MANUFACTURING_OUTPUT
  MANUFACTURING_INPUT
  ADJUSTMENT
  REVERSAL
}

model Client {
  id                   String                      @id @default(uuid())
  name                 String                      @unique
  status               OrganizationStatus          @default(ACTIVE)
  createdAt            DateTime                    @default(now()) @map("created_at")
  updatedAt            DateTime                    @updatedAt @map("updated_at")

  users                User[]
  warehouseAssignments ClientWarehouseAssignment[]
  categories           Category[]
  products             Product[]
  stockLocation        StockLocation?

  @@map("clients")
}

model Warehouse {
  id                  String                      @id @default(uuid())
  name                String                      @unique
  locationDescription String?                     @map("location_description")
  status              OrganizationStatus          @default(ACTIVE)
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  users               User[]
  clientAssignments   ClientWarehouseAssignment[]
  stockLocation       StockLocation?

  @@map("warehouses")
}

model ClientWarehouseAssignment {
  id           String    @id @default(uuid())
  clientId     String    @map("client_id")
  warehouseId  String    @map("warehouse_id")
  isActive     Boolean   @default(true) @map("is_active")
  activeFrom   DateTime  @default(now()) @map("active_from")
  inactiveFrom DateTime? @map("inactive_from")
  changedById  String?   @map("changed_by_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  client       Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  warehouse    Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  changedBy    User?     @relation(name: "AssignmentChangedBy", fields: [changedById], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([warehouseId])
  @@index([isActive])
  @@map("client_warehouse_assignments")
}

model Category {
  id          String       @id @default(uuid())
  parentId    String?      @map("parent_id")
  name        String
  ownerScope  CatalogScope @default(COMPANY) @map("owner_scope")
  clientId    String?      @map("client_id")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  parent      Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[]   @relation("CategoryHierarchy")
  products    Product[]
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([name, ownerScope, clientId])
  @@map("categories")
}

model Product {
  id                String             @id @default(uuid())
  ownerScope        CatalogScope       @map("owner_scope")
  clientId          String?            @map("client_id")
  categoryId        String             @map("category_id")
  name              String
  brand             String?
  description       String?
  imageRef          String?            @map("image_ref")
  status            ProductStatus      @default(PENDING_APPROVAL)
  quantityPrecision Int                @default(0) @map("quantity_precision") // 0 to 2
  allowFractional   Boolean            @default(false) @map("allow_fractional")
  trackingMode      TrackingMode       @default(NONE) @map("tracking_mode")
  minQuantity       Decimal            @default(0) @map("min_quantity") @db.Decimal(18, 2)
  duplicateKey      String             @unique @map("duplicate_key")
  rejectionReason   String?            @map("rejection_reason")
  approvedById      String?            @map("approved_by_id")
  approvedAt        DateTime?          @map("approved_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  client            Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  approvedBy        User?              @relation("ProductApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  attributes        ProductAttribute[]
  units             ProductUnit[]
  batches           StockBatch[]
  balances          InventoryBalance[]
  ledgerEntries     LedgerEntry[]

  @@index([ownerScope])
  @@index([clientId])
  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductAttribute {
  id            String   @id @default(uuid())
  productId     String   @map("product_id")
  attributeName String   @map("attribute_name")
  value         String
  unit          String?
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")

  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_attributes")
}

model ProductUnit {
  id               String     @id @default(uuid())
  productId        String     @map("product_id")
  unitName         String     @map("unit_name")
  isBaseUnit       Boolean    @default(false) @map("is_base_unit")
  conversionToBase Decimal    @default(1) @map("conversion_to_base") @db.Decimal(18, 4)
  effectiveFrom    DateTime   @default(now()) @map("effective_from")
  effectiveTo      DateTime?  @map("effective_to")
  status           UnitStatus @default(ACTIVE)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  product          Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([status])
  @@map("product_units")
}

model StockLocation {
  id           String             @id @default(uuid())
  locationType LocationType       @map("location_type")
  warehouseId  String?            @unique @map("warehouse_id")
  clientId     String?            @unique @map("client_id")
  createdAt    DateTime           @default(now()) @map("created_at")

  warehouse    Warehouse?         @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  client       Client?            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  balances     InventoryBalance[]
  ledgerEntries LedgerEntry[]

  @@map("stock_locations")
}

model StockBatch {
  id            String             @id @default(uuid())
  productId     String             @map("product_id")
  batchNumber   String?            @map("batch_number")
  expiryDate    DateTime?          @map("expiry_date")
  status        BatchStatus        @default(ACTIVE)
  createdAt     DateTime           @default(now()) @map("created_at")

  product       Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  balances      InventoryBalance[]
  ledgerEntries LedgerEntry[]

  @@unique([productId, batchNumber])
  @@index([expiryDate])
  @@map("stock_batches")
}

model InventoryBalance {
  id          String        @id @default(uuid())
  locationId  String        @map("location_id")
  productId   String        @map("product_id")
  batchId     String?       @map("batch_id")
  usableQty   Decimal       @default(0) @map("usable_qty") @db.Decimal(18, 4)
  reservedQty Decimal       @default(0) @map("reserved_qty") @db.Decimal(18, 4)
  damagedQty  Decimal       @default(0) @map("damaged_qty") @db.Decimal(18, 4)
  expiredQty  Decimal       @default(0) @map("expired_qty") @db.Decimal(18, 4)
  version     Int           @default(0)
  updatedAt   DateTime      @updatedAt @map("updated_at")

  location    StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  product     Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  batch       StockBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@unique([locationId, productId, batchId])
  @@index([locationId])
  @@index([productId])
  @@map("inventory_balances")
}

model LedgerTransaction {
  id             String          @id @default(uuid())
  transactionType TransactionType @map("transaction_type")
  sourceRefType  String?         @map("source_ref_type")
  sourceRefId    String?         @map("source_ref_id")
  idempotencyKey String?         @unique @map("idempotency_key")
  reversalOfTxId String?         @map("reversal_of_tx_id")
  postedById     String          @map("posted_by_id")
  postedAt       DateTime        @default(now()) @map("posted_at")

  postedBy       User            @relation(fields: [postedById], references: [id], onDelete: Restrict)
  entries        LedgerEntry[]

  @@index([postedAt])
  @@index([transactionType])
  @@map("ledger_transactions")
}

model LedgerEntry {
  id                       String         @id @default(uuid())
  transactionId            String         @map("transaction_id")
  locationId               String         @map("location_id")
  productId                String         @map("product_id")
  batchId                  String?        @map("batch_id")
  condition                StockCondition @default(USABLE)
  qtyDeltaBase             Decimal        @map("qty_delta_base") @db.Decimal(18, 4)
  originalQty              Decimal        @map("original_qty") @db.Decimal(18, 4)
  unitNameSnapshot         String         @map("unit_name_snapshot")
  conversionToBaseSnapshot Decimal        @map("conversion_to_base_snapshot") @db.Decimal(18, 4)
  reversalOfEntryId        String?        @map("reversal_of_entry_id")
  createdAt                DateTime       @default(now()) @map("created_at")

  transaction              LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  location                 StockLocation     @relation(fields: [locationId], references: [id], onDelete: Restrict)
  product                  Product           @relation(fields: [productId], references: [id], onDelete: Restrict)
  batch                    StockBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([locationId])
  @@index([productId])
  @@index([transactionId])
  @@map("ledger_entries")
}

model User {
  id                  String                      @id @default(uuid())
  username            String                      @unique
  passwordHash        String                      @map("password_hash")
  role                UserRole
  status              UserStatus                  @default(ACTIVE)
  clientId            String?                     @map("client_id")
  warehouseId         String?                     @map("warehouse_id")
  failedLoginAttempts Int                         @default(0) @map("failed_login_attempts")
  lockoutUntil        DateTime?                   @map("lockout_until")
  lockoutCount        Int                         @default(0) @map("lockout_count")
  disabledAt          DateTime?                   @map("disabled_at")
  createdAt           DateTime                    @default(now()) @map("created_at")
  updatedAt           DateTime                    @updatedAt @map("updated_at")

  client              Client?                     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  warehouse           Warehouse?                  @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  sessions            Session[]
  loginEvents         LoginEvent[]
  assignmentChanges   ClientWarehouseAssignment[] @relation("AssignmentChangedBy")
  approvedProducts    Product[]                   @relation("ProductApprovedBy")
  postedTransactions  LedgerTransaction[]

  @@index([clientId])
  @@index([warehouseId])
  @@map("users")
}

model Session {
  id             String    @id @default(uuid())
  userId         String    @map("user_id")
  tokenHash      String    @unique @map("token_hash")
  isRevoked      Boolean   @default(false) @map("is_revoked")
  revokedAt      DateTime? @map("revoked_at")
  lastActivityAt DateTime  @default(now()) @map("last_activity_at")
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model LoginEvent {
  id                String       @id @default(uuid())
  usernameAttempted String       @map("username_attempted")
  userId            String?      @map("user_id")
  outcome           LoginOutcome
  ipAddress         String?      @map("ip_address")
  userAgent         String?      @map("user_agent")
  occurredAt        DateTime     @default(now()) @map("occurred_at")

  user              User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([usernameAttempted])
  @@index([occurredAt])
  @@map("login_events")
}
