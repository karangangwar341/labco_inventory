# ==============================================================================
# Labco Warehouse & AI Agent Platform - Backend Environment Variables
# ==============================================================================

# Application Environment
NODE_ENV=development
PORT=4000

# Neon Serverless PostgreSQL Connection URLs
# Pooled connection string (with PgBouncer) for high-concurrency app/serverless runtime
DATABASE_URL="postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"
# Direct connection string for Prisma CLI migrations, DDL, and schema sync
DIRECT_URL="postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/[dbname]?sslmode=require"

# Authentication & JWT Security
# CRITICAL: In production, generate a secure random 64-character secret
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Neon Object Storage (S3-Compatible Blob Storage)
# Driver options: 'neon_s3' | 's3' | 'local' (offline development fallback)
STORAGE_DRIVER=neon_s3
AWS_ACCESS_KEY_ID=your_neon_storage_access_key_id
AWS_SECRET_ACCESS_KEY=your_neon_storage_secret_access_key
AWS_ENDPOINT_URL_S3=https://storage.neon.tech
AWS_REGION=us-east-1
STORAGE_BUCKET_NAME=warehouse-inventory-assets
STORAGE_LOCAL_PATH=./storage/uploads
MAX_FILE_SIZE_BYTES=10485760

# Google Gemini Extraction API (for AI document import adapter)
GEMINI_API_KEY=your_gemini_api_key_here

# CORS Allowed Origins (Comma-separated list; reflection is prohibited)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
