# ====================================================================
# Environment Configuration Template
# NOTE: Never commit sensitive credentials or real secrets into Git.
# ====================================================================

# Application Environment
NODE_ENV=development
PORT=4000

# PostgreSQL Database Configuration
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/warehouse_db?schema=public"

# Authentication & JWT
# Minimum 32-character high-entropy secret in production
JWT_SECRET=super_secret_jwt_signing_key_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=super_secret_refresh_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# File Storage Configuration
# Options: 'local' (development) | 's3' (production - provider deferred)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage/uploads
MAX_FILE_SIZE_BYTES=10485760

# Google Gemini Document Extraction API
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
