# ====================================================================
# Environment Configuration Template
# NOTE: Never commit sensitive credentials or real secrets into Git.
# ====================================================================

# Application Environment
NODE_ENV=development
PORT=4000

# Neon Serverless PostgreSQL Database Configuration
# Pooled connection string (with PgBouncer) for app/serverless runtime
DATABASE_URL="postgresql://[user]:[password]@[endpoint-id]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"
# Direct connection string for Prisma migrations, DDL, and schema sync
DIRECT_URL="postgresql://[user]:[password]@[endpoint-id].[region].aws.neon.tech/[dbname]?sslmode=require"

# Authentication & JWT
# Leave blank locally until configured. Use a unique generated secret in production.
JWT_SECRET=
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=7d

# Neon Object Storage (S3-Compatible Blob Storage)
# Driver options: 'neon_s3' | 's3' | 'local' (offline development fallback)
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://storage.neon.tech
AWS_REGION=us-east-1
STORAGE_BUCKET_NAME=warehouse-inventory-assets
STORAGE_LOCAL_PATH=./storage/uploads
MAX_FILE_SIZE_BYTES=10485760

# Google Gemini Document Extraction API
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Set only when deployed behind a known proxy; use the exact trusted hop count.
# TRUST_PROXY_HOPS=
# Production API docs are disabled unless this is explicitly enabled.
# ENABLE_API_DOCS=false
